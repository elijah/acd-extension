{
    "manifest_version": 3,
    "name": "AI Content Disclosure",
    "version": "0.1.0",
    "description": "Labels pages with AI content disclosure tags.",
    "permissions": ["activeTab"],
    "content_scripts": [
        {
            "matches": ["<all_urls>"],
            "js": ["content.js"],
            "css": ["content.css"],
            "run_at": "document_idle"
        }
    ]
}
